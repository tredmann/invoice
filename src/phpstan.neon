includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app

    # The level 8 is the highest level
    level: 5

    ignoreErrors:



    excludePaths:
        - *Filter.php
        - *Actions/Fortify/CreateNewUser.php
        - *Resource.php

    checkFunctionNameCase: true
